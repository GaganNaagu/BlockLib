generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

model User {
  id            String   @id @default(cuid())
  name          String
  usn           String?  @unique
  email         String   @unique
  passwordHash  String
  role          Role     @default(STUDENT)
  walletAddress String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Book {
  id          String   @id @default(cuid())
  chainBookId Int      @unique
  title       String
  author      String
  isbn        String   @unique
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
